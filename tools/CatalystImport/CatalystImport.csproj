<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One-off build-time importer: the ONLY thing that references Catalyst.
    It extracts Catalyst's embedded, offline language-detection model into a small
    portable file that PredictiveCoding.Data loads natively (no Catalyst at runtime).
    Not part of the solution / shipped output.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CatalystImport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Catalyst" Version="26.6.1528" />
    <PackageReference Include="Mosaik.Core" Version="25.10.62118" />
  </ItemGroup>

</Project>
