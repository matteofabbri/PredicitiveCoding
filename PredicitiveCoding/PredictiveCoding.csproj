<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PredictiveCoding</RootNamespace>
    <AssemblyName>PredictiveCoding</AssemblyName>
    <!-- AOT disabled: incompatible with reflection patterns used in the research framework -->
    <PublishAot>false</PublishAot>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.8" />
  </ItemGroup>

</Project>
