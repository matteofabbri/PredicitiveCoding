<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PredictiveCoding.Device</RootNamespace>
    <AssemblyName>PredictiveCoding.Device</AssemblyName>
    <Copyright>Copyright (c) 2026 Matteo Fabbri</Copyright>
    <PackageLicenseExpression>PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PredicitiveCoding\PredictiveCoding.csproj" />
    <ProjectReference Include="..\PredictiveCoding.LLM\PredictiveCoding.LLM.csproj" />
  </ItemGroup>

  <!--
    No custom native library: GPU work P/Invokes the standard CUDA Toolkit
    libraries (cudart, cublas) via Interop/NativeResolver. Install the CUDA
    Toolkit for GPU acceleration; otherwise everything runs on the CPU.
  -->

</Project>
