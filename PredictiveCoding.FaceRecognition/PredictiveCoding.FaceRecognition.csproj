<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PredictiveCoding.FaceRecognition</RootNamespace>
    <AssemblyName>PredictiveCoding.FaceRecognition</AssemblyName>
    <!-- NU1902: moderate ImageSharp advisory (GHSA-rxmq-m78w-7wmc) still open on the 3.1.x line; we only decode trusted dataset images. -->
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PredicitiveCoding\PredictiveCoding.csproj" />
    <ProjectReference Include="..\PredictiveCoding.Expanded\PredictiveCoding.Expanded.csproj" />
    <!-- In-house ONNX executor: lets the detectors run without ONNX Runtime (opt-in flag). -->
    <ProjectReference Include="..\PredictiveCoding.Onnx\PredictiveCoding.Onnx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.26.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.10" />
  </ItemGroup>

</Project>
