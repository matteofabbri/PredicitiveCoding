<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PredictiveCoding.Data</RootNamespace>
    <AssemblyName>PredictiveCoding.Data</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.2" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CodeHollow.FeedReader" Version="1.2.6" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="fo-dicom" Version="5.2.6" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NWaves" Version="0.9.6" />
    <PackageReference Include="Octokit" Version="14.0.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="Parquet.Net" Version="6.0.3" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="VersOne.Epub" Version="3.3.6" />
    <PackageReference Include="YoutubeExplode" Version="6.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PredicitiveCoding\PredictiveCoding.csproj" />
    <ProjectReference Include="..\PredictiveCoding.Imaging\PredictiveCoding.Imaging.csproj" />
  </ItemGroup>

  <!-- Offline language-detection assets. LangProfiles/*: the original langdetect
       n-gram profiles (53 languages, Nakatani Shuyo, Apache 2.0) plus languages.xml
       (ISO-639 table), imported verbatim from Maddalena.Cognitive.
       language-samples.tsv: seed corpus for the native trainable n-gram classifier. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\LangProfiles\*" />
    <EmbeddedResource Include="Resources\languages.xml" />
    <EmbeddedResource Include="Resources\language-samples.tsv" />
  </ItemGroup>

</Project>
