<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PredictiveCoding.Vision</RootNamespace>
    <AssemblyName>PredictiveCoding.Vision</AssemblyName>
    <Copyright>Copyright (c) 2026 Matteo Fabbri</Copyright>
    <PackageLicenseExpression>PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuses the ONNX detector pattern, NMS/IoU and CUDA provisioning already in FaceRecognition. -->
    <ProjectReference Include="..\PredictiveCoding.FaceRecognition\PredictiveCoding.FaceRecognition.csproj" />
    <!-- In-house ONNX executor: lets YoloPersonDetector run without ONNX Runtime (opt-in flag). -->
    <ProjectReference Include="..\PredictiveCoding.Onnx\PredictiveCoding.Onnx.csproj" />
    <ProjectReference Include="..\PredictiveCoding.Imaging\PredictiveCoding.Imaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.26.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260602" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260602" />
  </ItemGroup>

</Project>
