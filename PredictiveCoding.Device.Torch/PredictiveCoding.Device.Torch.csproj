<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PredictiveCoding.Device.Torch</RootNamespace>
    <AssemblyName>PredictiveCoding.Device.Torch</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PredictiveCoding.Device\PredictiveCoding.Device.csproj" />
  </ItemGroup>

  <!--
    TorchSharp is managed bindings to LibTorch; this package alone compiles
    everywhere. To actually run on a device, add ONE platform backend package:
      • macOS (Apple Silicon, Metal/MPS): libtorch-cpu-macos-arm64  (ships MPS)
      • NVIDIA CUDA:                       libtorch-cuda-12.x
      • CPU only:                          libtorch-cpu
  -->
  <ItemGroup>
    <PackageReference Include="TorchSharp" Version="0.105.0" />
  </ItemGroup>

</Project>
