<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PredictiveCoding.OmniMind.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PredictiveCoding.OmniMind"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OmniMind — Predictive Coding">

    <Grid Background="#0B0E14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="22,18,22,10" Spacing="6">
            <TextBlock Text="OmniMind" FontSize="30" FontWeight="Bold" Foreground="#EAF0FF" />
            <TextBlock Text="One mind. Every external source. Read live, learned in seconds."
                       FontSize="14" Foreground="#7E8AA3" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBox x:Name="TopicBox" Width="360" PlaceholderText="Enter a topic…" Text="black holes"
                         KeyDown="TopicBox_KeyDown" />
                <Button x:Name="IgniteButton" Content="Ignite" Click="Ignite_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing x:Name="Ring" IsActive="False" Width="22" Height="22" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#7E8AA3" Text="Ready." />
            </StackPanel>
            <TextBlock FontSize="11" Foreground="#55607A"
                       Text="Live calls to ~24 external providers. Optional keys via env: GITHUB_TOKEN · ELSEVIER_API_KEY · UNPAYWALL_EMAIL" />
        </StackPanel>

        <!-- Body -->
        <Grid Grid.Row="1" Padding="16,4,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Live source dashboard -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="SourcesText" Margin="6,0,0,8"
                           Foreground="#9AA7C2" FontWeight="SemiBold" Text="Sources" />
                <GridView Grid.Row="1" x:Name="TilesView" SelectionMode="None" IsItemClickEnabled="False"
                          Padding="2">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="184" Height="86" Margin="4" CornerRadius="10"
                                    Background="#141A26" BorderThickness="1" BorderBrush="#202838">
                                <Grid Padding="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Width="6" RadiusX="3" RadiusY="3"
                                               Fill="{Binding Accent}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="#EAF0FF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#6E7A95" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#9AA7C2"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- The mind -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Margin="4,0,2,0">

                    <Border CornerRadius="10" Background="#141A26" Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Fused corpus" Foreground="#9AA7C2" FontWeight="SemiBold" />
                            <TextBlock x:Name="CorpusText" Foreground="#EAF0FF" Text="—" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="10" Background="#141A26" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Learning the topic (live, from scratch)"
                                       Foreground="#9AA7C2" FontWeight="SemiBold" />
                            <Border CornerRadius="6" Background="#0E1422">
                                <Canvas x:Name="LossCanvas" Height="130" />
                            </Border>
                            <TextBlock x:Name="LossText" Foreground="#9AA7C2" FontSize="12"
                                       TextWrapping="Wrap" Text="awaiting corpus…" />
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="10" Background="#141A26" Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="In its own (freshly trained) words"
                                       Foreground="#9AA7C2" FontWeight="SemiBold" />
                            <TextBlock x:Name="GeneratedText" Foreground="#C8FFD0" FontFamily="Consolas"
                                       TextWrapping="Wrap" MinHeight="84" Text="" />
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="10" Background="#141A26" Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Cross-source concepts" Foreground="#9AA7C2" FontWeight="SemiBold" />
                            <TextBlock x:Name="ConnectionsText" Foreground="#B9C4DC" TextWrapping="Wrap" Text="—" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
