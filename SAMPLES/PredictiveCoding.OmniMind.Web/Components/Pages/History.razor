@page "/history"
@inject HistoryStore History

<PageTitle>OmniMind · History</PageTitle>

<div class="ignite-head">
    <h1>History</h1>
    <p class="muted">@count run@(count == 1 ? "" : "s") learned and stored in Sperone.</p>

    <div class="ignite-controls">
        <input class="topic-box" @bind="query" @bind:event="oninput" @onkeydown="OnKey"
               placeholder="Search topics…" />
        <button class="btn" @onclick="RunSearch">Search</button>
        @if (!string.IsNullOrWhiteSpace(query))
        {
            <button class="btn" @onclick="Clear">Clear</button>
        }
    </div>
</div>

<div class="history-list">
    @if (runs.Count == 0)
    {
        <p class="muted" style="padding:16px">
            @(string.IsNullOrWhiteSpace(query) ? "No runs yet — ignite a topic first." : "No runs match that search.")
        </p>
    }
    @foreach (var r in runs)
    {
        <a class="run-card" href="@($"history/{r.Id}")">
            <div class="run-topic">@r.Topic</div>
            <div class="run-meta">
                @r.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")
                · @r.LiveSources/@r.TotalSources live
                · @r.CorpusDocs docs
                · loss @r.FinalLoss.ToString("F2")
            </div>
            @if (!string.IsNullOrWhiteSpace(r.GeneratedText))
            {
                <div class="run-snippet">@Snippet(r.GeneratedText)</div>
            }
        </a>
    }
</div>

@code {
    private string query = "";
    private List<RunRecord> runs = [];
    private long count;

    protected override void OnInitialized()
    {
        count = History.Count;
        RunSearch();
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") RunSearch();
    }

    private void RunSearch() =>
        runs = (string.IsNullOrWhiteSpace(query) ? History.ListRecent() : History.Search(query)).ToList();

    private void Clear()
    {
        query = "";
        RunSearch();
    }

    private static string Snippet(string s) =>
        s.Length <= 180 ? s : string.Concat(s.AsSpan(0, 180), "…");
}
