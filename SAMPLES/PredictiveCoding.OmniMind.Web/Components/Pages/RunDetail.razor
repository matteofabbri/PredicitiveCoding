@page "/history/{Id}"
@inject HistoryStore History

<PageTitle>OmniMind · Run</PageTitle>

@if (run is null)
{
    <div class="ignite-head">
        <h1>Run not found</h1>
        <p class="muted"><a href="history">← back to history</a></p>
    </div>
}
else
{
    <div class="ignite-head">
        <h1>@run.Topic</h1>
        <p class="muted">
            @run.CreatedAt.LocalDateTime.ToString("f")
            · @run.DurationMs.ToString("N0") ms
            · @run.LiveSources/@run.TotalSources live sources
        </p>
        <p class="muted"><a href="history">← back to history</a></p>
    </div>

    <div class="ignite-grid">
        <section class="panel sources-panel">
            <div class="panel-title">Sources <span class="muted">— @run.LiveSources live</span></div>
            <div class="tiles">
                @foreach (var o in run.Sources)
                {
                    <SourceTile Source="@ToLive(o)" />
                }
            </div>
        </section>

        <aside class="mind-col">
            <section class="panel">
                <div class="panel-title">Fused corpus</div>
                <div class="panel-body">
                    @run.CorpusDocs.ToString("N0") documents · @run.CorpusChars.ToString("N0") characters · @run.LiveSources live sources.
                </div>
            </section>

            <section class="panel">
                <div class="panel-title">Learning curve</div>
                <LossChart Points="run.LossHistory" />
                <div class="panel-body small">
                    final loss @run.FinalLoss.ToString("F3") · perplexity @run.FinalPerplexity.ToString("F1")
                    · vocab @run.Vocab · @run.Params.ToString("N0") params
                </div>
            </section>

            <section class="panel">
                <div class="panel-title">In its own words</div>
                <pre class="generated">@run.GeneratedText</pre>
            </section>

            <section class="panel">
                <div class="panel-title">Cross-source concepts</div>
                <div class="concepts">
                    @foreach (var t in run.TopTerms)
                    {
                        <span class="chip">@t</span>
                    }
                </div>
            </section>
        </aside>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private RunRecord? run;

    protected override void OnParametersSet() => run = History.Get(Id);

    private static LiveSource ToLive(SourceOutcome o) =>
        new() { Name = o.Name, Category = o.Category, Status = LiveSourceStatus.Done, Outcome = o };
}
