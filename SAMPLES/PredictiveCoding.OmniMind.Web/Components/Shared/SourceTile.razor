<div class="tile @StatusClass">
    <span class="tile-accent" style="background:@Accent"></span>
    <div class="tile-body">
        <div class="tile-name" title="@Source.Name">@Source.Name</div>
        <div class="tile-cat">@Source.Category</div>
        <div class="tile-detail" title="@Detail">@Detail</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public LiveSource Source { get; set; } = default!;

    private string StatusClass => Source.Status switch
    {
        LiveSourceStatus.Running => "running",
        LiveSourceStatus.Done => (Source.Outcome?.State ?? "done").ToLowerInvariant(),
        _ => "queued",
    };

    private string Accent => Source.Status switch
    {
        LiveSourceStatus.Queued => "#3A404F",
        LiveSourceStatus.Running => "#F5A623",
        _ => Source.Outcome?.State switch
        {
            "Ok" => "#34C759",
            "Empty" => "#5A7A8A",
            "Skipped" => "#8E8E93",
            "Failed" => "#FF453A",
            _ => "#3A404F",
        },
    };

    private string Detail => Source.Status switch
    {
        LiveSourceStatus.Queued => "queued",
        LiveSourceStatus.Running => "probing…",
        _ => Source.Outcome is { } o ? $"{Head(o)} · {o.Detail} · {o.ElapsedMs} ms" : "done",
    };

    private static string Head(SourceOutcome o) => o.State switch
    {
        "Ok" => $"{o.ItemCount} items",
        "Empty" => "no data",
        "Skipped" => "needs key",
        "Failed" => "failed",
        _ => "",
    };
}
